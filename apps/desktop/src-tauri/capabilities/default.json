{
  "$schema": "https://schemas.tauri.build/capability/v2/_manifest.json",
  "identifier": "default",
  "description": "Default, least-privilege capability for the NerdHub desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:app:quit",
    "core:app:get-current",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:window:close",
    "core:window:hide",
    "core:window:show",
    "core:window:set-focus",
    "core:webview:allow-downloads"
  ]
}
