{
  "name": "@nerdhub/worker",
  "version": "0.0.0-m0",
  "private": true,
  "description": "NerdHub BullMQ background worker process.",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nerdhub/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.5.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nerdhub/config": "workspace:*",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.13.0",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  }
}
