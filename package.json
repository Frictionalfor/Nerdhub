{
  "name": "nerdhub",
  "private": true,
  "description": "NerdHub — A place where curiosity has no boundaries.",
  "version": "0.0.0-m0",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "studio": "pnpm --filter @nerdhub/api prisma studio",
    "db:generate": "pnpm --filter @nerdhub/api prisma generate",
    "db:migrate:deploy": "pnpm --filter @nerdhub/api prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @nerdhub/api prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@nerdhub/config": "workspace:*",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.0",
    "prisma": "^6.5.0",
    "turbo": "^2.4.0",
    "typescript": "~5.8.0"
  },
  "peerDependencies": {
    "typescript": "~5.8.0"
  }
}
