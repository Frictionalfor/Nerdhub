# NerdHub local development environment.
#
# Copy this file to `.env` and adjust for your machine.
#   cp .env.example .env
#
# Never commit real secrets. `.env` is gitignored.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (PostgreSQL, provided by docker-compose) ---
DATABASE_URL=postgresql://nerdhub:nerdhub@localhost:5432/nerdhub

# --- Cache / jobs (Redis, provided by docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_BASE_URL=http://localhost:4000

# Comma-separated list of origins allowed to call the API (CORS).
# In development this defaults to http://localhost:5173 (Vite dev server).
# In production you MUST set this explicitly; an empty value rejects all origins.
ALLOWED_ORIGINS=http://localhost:5173

# --- Session / auth secrets ---
# Replace with strong random material before any non-local deployment.
SESSION_SECRET=replace-with-a-strong-secret-of-at-least-32-characters

# --- OAuth provider credentials (server-side only) ---
# These are never bundled into the desktop renderer.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (use a local mail catcher / sandbox in development) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.local

# --- Object storage (S3-compatible, private by default) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
